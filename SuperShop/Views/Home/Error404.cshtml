
@{
    ViewData["Title"] = "Error404";
}

<h2>Ups! Page not found!!</h2>


<div class="error-404">

    <svg xmlns="http://www.w3.org/2000/svg"
         id="robot-error-404"
         viewBox="0 0 260 118.9"
         role="img">

        <title>404 Error</title>

        <defs>

            <clipPath id="white-clip-404">
                <circle fill="#cacaca"
                        cx="130"
                        cy="65"
                        r="20" />
            </clipPath>

            <text id="text-404"
                  class="error-text-404"
                  y="106">
                404
            </text>

        </defs>

        <path class="alarm-404"
              fill="#e62326"
              d="M120.9 19.6V9.1c0-5 4.1-9.1 9.1-9.1h0c5 0 9.1 4.1 9.1 9.1v10.6" />

        <use href="#text-404"
             x="-0.5px"
             y="-1px"
             fill="black">
        </use>

        <use href="#text-404"
             fill="#2b2b2b">
        </use>

        <g id="robot-404">

            <g id="eye-wrap-404">

                <use href="#white-clip-404"></use>

                <circle class="eye-404"
                        clip-path="url(#white-clip-404)"
                        fill="#000"
                        stroke="#2aa7cc"
                        stroke-width="2"
                        stroke-miterlimit="10"
                        cx="130"
                        cy="65"
                        r="11" />

                <ellipse fill="#2b2b2b"
                         cx="130"
                         cy="40"
                         rx="18"
                         ry="12" />

            </g>

            <circle class="lightblue-404"
                    cx="105"
                    cy="32"
                    r="2.5" />

            <circle class="lightblue-404"
                    cx="155"
                    cy="32"
                    r="2.5" />

            <circle class="lightblue-404"
                    cx="155"
                    cy="92"
                    r="2.5" />

            <circle class="lightblue-404"
                    cx="105"
                    cy="92"
                    r="2.5" />

        </g>

    </svg>

    <h1 class="h1-notfound">404</h1>

    <h2 class="h2-notfound">
        Página não encontrada!
    </h2>

    <p class="back-home-404">
        <a href="/">Voltar à página inicial</a>
    </p>

</div>